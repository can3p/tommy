{
  "openapi": "3.1.0",
  "info": {
    "title": "tommy as2 API",
    "version": "v1",
    "description": "Stands in for a trading partner's AS2 endpoint: it accepts the EDIINT messages your integration posts - signed, encrypted, compressed, in any combination - and answers with the MDN receipt the sender is waiting on, so an AS2 client runs unmodified against a fake. The AS2 tab shows each message unwrapped layer by layer, the EDI document that was inside, the computed MIC and exactly what the signature did and did not prove.\n\nThese routes read back what tommy captured, in the shape this content type\nwants: filters that only mean something here, and the parts that are bytes\nrather than JSON. They read from the same store as the events API, so a\nclient that sends and immediately fetches sees its own write, and every\nentry carries the id of the event behind it.\n\nThe events API - /api/v1/events, described in its own document - is the\ngeneric view of the same captures, and is the one to use when what you are\nasserting does not depend on the content type. The fake vendor endpoints are\ndescribed nowhere here: they are the vendors' specifications, not tommy's.\n\nThis document is generated from the server's route table. It cannot describe\na route that does not exist, and CI fails if the checked-in copy stops\nmatching the code."
  },
  "servers": [
    {
      "url": "/api/v1/as2",
      "description": "This tommy's as2 API."
    }
  ],
  "security": [],
  "paths": {
    "/certificate": {
      "get": {
        "operationId": "getCertificate",
        "summary": "Tommy's certificate as PEM, for a trading partner to import.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/x-pem-file": {}
            }
          }
        }
      }
    },
    "/identity": {
      "get": {
        "operationId": "getIdentity",
        "summary": "Which certificate is in use, where it came from, and its fingerprint.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/as2.IdentityInfo"
                }
              }
            }
          }
        }
      }
    },
    "/messages": {
      "get": {
        "operationId": "getMessages",
        "summary": "Every captured AS2 message, newest first.",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "description": "Only entries captured by this provider, such as mailjet.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Only entries of this event type, such as mail.message.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive substring over the summary and type.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "RFC3339 timestamp, a duration such as 5m, or unix milliseconds.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of entries to return.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "How many entries to skip.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "The partner's AS2-From identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "The AS2-To identifier the message was addressed to.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message_id",
            "in": "query",
            "description": "The AS2 Message-ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "The business document's format, such as edifact or x12.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "security",
            "in": "query",
            "description": "Which layers were used: signed, encrypted, compressed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "issue",
            "in": "query",
            "description": "Only messages tommy recorded a problem with, such as a signature it could not verify.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/as2.MessageEnvelope"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter could not be parsed - a malformed since, a negative limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/api.Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMessages",
        "summary": "Clear every captured AS2 message.",
        "responses": {
          "204": {
            "description": "Done. No body."
          }
        }
      }
    },
    "/messages/{id}": {
      "get": {
        "operationId": "getMessagesById",
        "summary": "One message, unwrapped through every layer it arrived in.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The event id, as returned by any listing.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/as2.MessageEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such resource, or it belongs to another plugin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/api.Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMessagesById",
        "summary": "Delete one captured message.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The event id, as returned by any listing.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done. No body."
          },
          "404": {
            "description": "No such resource, or it belongs to another plugin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/api.Error"
                }
              }
            }
          }
        }
      }
    },
