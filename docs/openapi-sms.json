        ]
      },
      "sms.MessageEnvelope": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/sms.MediaRef"
            }
          },
          "message": {
            "$ref": "#/components/schemas/sms.Message"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {}
          },
          "provider": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "message",
          "provider",
          "received_at",
          "type"
        ]
      },
      "sms.Segments": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "encoding": {
            "type": "string"
          },
          "remaining": {
            "type": "integer"
          },
          "units": {
            "type": "integer"
          }
        },
        "required": [
          "capacity",
          "count",
          "encoding",
          "remaining",
          "units"
        ]
      }
    }
  }
}
