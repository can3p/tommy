          "size"
        ]
      },
      "sms.Media": {
        "type": "object",
        "properties": {
          "blob": {
            "$ref": "#/components/schemas/blob.Ref"
          },
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "sms.MediaRef": {
        "type": "object",
