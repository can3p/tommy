          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/sms.Media"
            }
          },
          "messaging_service": {
            "type": "string"
          },
          "segments": {
            "$ref": "#/components/schemas/sms.Segments"
          },
