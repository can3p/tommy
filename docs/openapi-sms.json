          },
          "index": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "stored": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "stored",
          "url"
        ]
      },
      "sms.Message": {
        "type": "object",
