            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/mail.Address"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/mail.Address"
            }
          },
          "from": {
            "$ref": "#/components/schemas/mail.Address"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "html": {
            "type": "string"
          },
          "reply_to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/mail.Address"
            }
          },
          "subject": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/mail.Address"
            }
          }
        },
        "required": [
          "from"
        ]
      },
      "mail.MessageLinks": {
        "type": "object",
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "html": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "self": {
            "type": "string"
          },
          "text": {
            "type": "string"
