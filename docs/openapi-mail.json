      },
      "mail.MessageView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/mail.MessageLinks"
          },
          "message": {
            "$ref": "#/components/schemas/mail.Message"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {}
          },
          "provider": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "links",
          "message",
          "provider",
          "received_at",
          "type"
        ]
      }
    }
  }
}
