          },
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "inline": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "blob",
          "size"
        ]
      },
      "mail.Message": {
        "type": "object",
        "properties": {
          "attachments": {
            "type": "array",
